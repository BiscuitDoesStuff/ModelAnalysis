# Local-only. Copy to .env (gitignored) or set in OS env. Never paste into reports/chats.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: raises OpenRouter rate limits, needed for full OpenRouter auth listing
OPENROUTER_API_KEY=
# Artificial Analysis free key from artificialanalysis.ai — scores/prices/speed
AA_API_KEY=
# Groq + Cerebras (OpenAI-compatible /models catalogs; skipped when absent)
# Note: Cerebras requires payment info on their site before it issues an API key —
# skip it if you'd rather not; the pipeline runs fine without it.
GROQ_API_KEY=
CEREBRAS_API_KEY=
# Optional free-validation keys (v2, not needed for v1 retrieval)
NVIDIA_API_KEY=
GOOGLE_AI_STUDIO_KEY=
