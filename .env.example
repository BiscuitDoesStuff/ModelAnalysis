# Local-only. Copy to .env (gitignored) or set in OS env. Never paste into reports/chats.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: raises OpenRouter rate limits, needed for full OpenRouter auth listing
OPENROUTER_API_KEY=
# Artificial Analysis free key from artificialanalysis.ai — scores/prices/speed
AA_API_KEY=
# LLM Stats / ZeroEval API key (llm-stats.com/developer) — category scores/bulk snapshots; skipped when absent
LLM_STATS_API_KEY=
# Optional: per-model detail cap for the LLM Stats keyed fetch (default 12, 0 to disable).
# Each detail is 1 quota response; a full run uses ~7 + details (Community: 250/day).
LLM_STATS_DETAIL_MAX=
# Optional free-validation keys (v2, not needed for v1 retrieval)
NVIDIA_API_KEY=
GOOGLE_AI_STUDIO_KEY=
